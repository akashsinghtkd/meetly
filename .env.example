# Copy to .env.local and fill in to enable cloud sync + the web app.
# Leave unset to run the desktop app fully local (no account, no sync).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Stripe (paid plans via Checkout). Without these, Team → Plan uses
# local "dev mode" activation (dev_set_teamspace_plan RPC).
VITE_STRIPE_PUBLISHABLE_KEY=

# Edge function secrets (set via `supabase secrets set`, not in Vite):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_BUSINESS=price_...
